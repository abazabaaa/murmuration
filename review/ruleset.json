{
 "ruleset_version": "0.4",
 "compiled_from": "policy.md v0.4 (hand-compiled; every rule cites its clause; gates live in engine.py)",
 "notes": "Fields are the flattened Extraction (engine.flatten): each Obs becomes its 'holds' value; render_artefacts counts reported artefacts of rendering kinds. Kleene logic: a null field makes a comparison unknown, which routes to needs_review, never to approve. approve_needs_scope (v0.4): when such a rule is out of scope, its axis cannot approve; it goes to needs_review with the reason on the card (policy S0, U2).",
 "rules": [
  {
   "id": "S1-silhouette",
   "axis": "S",
   "policy_ref": "S1",
   "action": "flag",
   "description": "Resolved birds do not have the starling outline.",
   "scope": {
    "field": "birds_resolved",
    "op": "eq",
    "value": true
   },
   "when": {
    "field": "s1_silhouette",
    "op": "eq",
    "value": false
   },
   "approve_needs_scope": true
  },
  {
   "id": "S2-flight-mode",
   "axis": "S",
   "policy_ref": "S2",
   "action": "flag",
   "description": "Wings are rigid, beat in unison, or beat slowly and deeply (under 6 per second).",
   "scope": {
    "field": "birds_resolved",
    "op": "eq",
    "value": true
   },
   "when": {
    "any": [
     {
      "field": "s2_flight_mode",
      "op": "eq",
      "value": false
     },
     {
      "all": [
       {
        "field": "wingbeat_hz",
        "op": "exists"
       },
       {
        "field": "wingbeat_hz",
        "op": "lt",
        "value": 6
       }
      ]
     }
    ]
   },
   "approve_needs_scope": true
  },
  {
   "id": "S3-flock-motion",
   "axis": "S",
   "policy_ref": "S3",
   "action": "flag",
   "description": "The flock does not move coherently and fluidly.",
   "when": {
    "field": "s3_flock_motion",
    "op": "eq",
    "value": false
   }
  },
  {
   "id": "S4-attitude-variety",
   "axis": "S",
   "policy_ref": "S4",
   "action": "flag",
   "description": "Many birds are identical copies in pose and angle.",
   "scope": {
    "field": "birds_resolved",
    "op": "eq",
    "value": true
   },
   "when": {
    "field": "s4_attitude_variety",
    "op": "eq",
    "value": false
   },
   "approve_needs_scope": true
  },
  {
