index 0000000..10425a0
--- /dev/null
+++ b/sim/neighbours-check.js
@@ -0,0 +1,68 @@
+#!/usr/bin/env node
+'use strict';
+// The grid neighbour search must return exactly what the original scan of every bird in index
+// order returns: the same birds, in the same order, with the same float32 distances.
+const assert=require('node:assert/strict'),path=require('node:path');
+const {host}=require('./page');
+const file=path.resolve(process.argv[2]||path.join(__dirname,'../murmuration.html'));
+const K=7;
+function brute(m,i){                        // the scan murmuration.html used before the grid
+  const {px,py,pz,N}=m,D=new Float32Array(K),I=new Int32Array(K),x=px[i],y=py[i],z=pz[i];let nb=0;
+  for(let j=0;j<N;j++){
+    if(j===i)continue;
+    const dx=px[j]-x,dy=py[j]-y,dz=pz[j]-z,d2=dx*dx+dy*dy+dz*dz;
+    if(nb===K&&d2>=D[K-1])continue;
+    let k=nb<K?nb++:K-1;
+    while(k>0&&D[k-1]>d2){D[k]=D[k-1];I[k]=I[k-1];k--;}
+    D[k]=d2;I[k]=j;
+  }
+  return {nb,D:[...D.slice(0,nb)],I:[...I.slice(0,nb)]};
+}
+function compareAll(m,label){
+  m.buildGrid();
+  for(let i=0;i<m.N;i++){
+    const nb=m.neighbours(i),want=brute(m,i);
+    assert.equal(nb,want.nb,`${label}: bird ${i} found ${nb} neighbours, scan ${want.nb}`);
+    assert.deepEqual([...m.nbI.slice(0,nb)],want.I,`${label}: bird ${i} neighbour ids differ`);
+    assert.deepEqual([...m.nbD.slice(0,nb)],want.D,`${label}: bird ${i} distances differ`);
+  }
+}
+let seed=99;const rnd=()=>(seed=Math.imul(seed^seed>>>15,2246822507)+1013904223>>>0)/4294967296;
+const counts={liveFrames:0,layouts:0,birds:0};
+// live flocks, calm and hunted, at several sizes
+for(const [n,q] of [[400,'calm'],[100,'falcon'],[1000,'calm'],[20,'calm'],[8,'calm']]){
+  const h=host(file,{query:`seed=3&n=${n}&${q}&painted&debug`}),m=h.state;
+  for(let f=0;f<240;f++){m.step(1/60,(f+1)/60);if(f%40===0){compareAll(m,`n${n} ${q} frame ${f}`);counts.liveFrames++;counts.birds+=n;}}
+}
+// adversarial layouts: exact ties on a lattice, duplicates, two far clouds, a lone straggler,
+// a flat sheet, everything at one point, and a float32 near-tie ladder
+const h=host(file,{query:'seed=1&n=400&calm&painted&debug'}),m=h.state,N=m.N,{px,py,pz}=m;
+const layouts={
+  lattice:i=>[i%8,(i>>3)%8,i>>6],
+  coarseLattice:i=>[(i%5)*3.7,((i/5|0)%5)*3.7,(i/25|0)*3.7],
+  duplicates:i=>{const k=i%37;return [k*.9,k*.4,-k];},
+  twoClouds:i=>i<200?[rnd()*10,rnd()*10,rnd()*10]:[5000+rnd()*10,rnd()*10,rnd()*10],
+  straggler:i=>i===0?[1e5,-3e4,2e4]:[rnd()*40,rnd()*20,rnd()*40],
+  sheet:i=>[rnd()*300,0,rnd()*300],
+  line:i=>[i*.25,0,0],
+  onePoint:()=>[7,7,7],
+  nearTies:i=>[1+(i%20)*1e-7,(i/20|0)*1e-7,0],
+  sparse:i=>[(rnd()-.5)*4000,(rnd()-.5)*4000,(rnd()-.5)*4000],
+};
+for(const [name,f] of Object.entries(layouts)){
+  for(let i=0;i<N;i++){const [x,y,z]=f(i);px[i]=x;py[i]=y;pz[i]=z;}
+  compareAll(m,name);counts.layouts++;counts.birds+=N;
+}
+// negative control: a search that stops one shell early must be caught
+{
+  for(let i=0;i<N;i++){px[i]=rnd()*60;py[i]=rnd()*60;pz[i]=rnd()*60;}
+  m.buildGrid();let caught=false;
+  for(let i=0;i<N&&!caught;i++){m.neighbours(i);const want=brute(m,i);
+    // the scan restricted to bird i's own cell neighbourhood would differ for some bird
+    const own=[...Array(N).keys()].filter(j=>Math.abs(px[j]-px[i])<3&&Math.abs(py[j]-py[i])<3&&Math.abs(pz[j]-pz[i])<3);
+    const D=new Float32Array(K),I=new Int32Array(K);let nb=0;
+    for(const j of own){if(j===i)continue;const dx=px[j]-px[i],dy=py[j]-py[i],dz=pz[j]-pz[i],d2=dx*dx+dy*dy+dz*dz;if(nb===K&&d2>=D[K-1])continue;let k=nb<K?nb++:K-1;while(k>0&&D[k-1]>d2){D[k]=D[k-1];I[k]=I[k-1];k--;}D[k]=d2;I[k]=j;}
+    if(nb!==want.nb||[...I.slice(0,nb)].join()!==want.I.join())caught=true;}
+  assert.ok(caught,'negative control: a truncated search was not distinguishable from the scan');
+}
+console.log(JSON.stringify({status:'passed',file,...counts}));
